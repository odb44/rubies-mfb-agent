flowchart TB
    %% Proposed logical deployment/runtime view. Exact hosting and container choices remain undecided.

    Client["Customer channel / client"]
    HumanSupport["Human support team or queue<br/>(integration not yet specified)"]

    subgraph AgentRuntime["Agent API process"]
        AgentAPI["Agent API routes"]
        Orchestrator["Agent orchestration"]
        Conversation["Conversation manager"]
        SessionAdapter["Strands File Session Manager adapter"]
        AgentAPI --> Orchestrator
        AgentAPI --> Conversation
        Conversation --> SessionAdapter
    end

    subgraph BankingRuntime["Banking API process"]
        BankingAPI["Banking API routes"]
        Identity["Trusted identity, ownership<br/>and permission enforcement"]
        Domain["Banking domain services"]
        Persistence["Persistence layer"]
        BankingAPI --> Identity --> Domain --> Persistence
    end

    subgraph MCPRuntime["MCP server process"]
        MCPEntry["MCP entry point"]
        MCPAuth["Per-tool authorization"]
        MCPTools["Registered tools and schemas"]
        MCPEntry --> MCPAuth --> MCPTools
    end

    subgraph KnowledgeResources["Knowledge resources"]
        Retrieval["Knowledge retrieval<br/>and citation assembly"]
        VectorIndex[("Local vector index")]
        Retrieval <--> VectorIndex
    end

    subgraph ModelResources["Loan-model resources"]
        Inference["Loan eligibility inference"]
        ModelArtifacts[("Versioned local model artifacts")]
        Inference --> ModelArtifacts
    end

    subgraph PersistentStores["Persistent stores"]
        Postgres[("PostgreSQL<br/>banking records, pending confirmations, audit")]
        SessionFiles[("Protected local session files<br/>conversation/session state")]
    end

    Client -->|"HTTPS / request-response"| AgentAPI
    Orchestrator -->|"RAG query"| Retrieval
    Orchestrator -->|"Eligibility request"| Inference
    Orchestrator -->|"Tool call"| MCPEntry
    MCPTools -->|"Authorized banking operation"| BankingAPI
    Domain --> Postgres
    Persistence --> Postgres
    SessionAdapter --> SessionFiles
    Orchestrator -->|"Escalation request"| HumanSupport
    Domain -.->|"Audit / operational events"| Obs["Observability package<br/>(logs, metrics, traces)"]
    AgentRuntime -.-> Obs
    BankingRuntime -.-> Obs
    MCPRuntime -.-> Obs

    Note["Deployment placement is intentionally abstract.<br/>No Docker/container, cloud-hosting, or network-topology choice is implied.<br/>Banking API is authoritative for identity, permissions, pending confirmations and banking writes."]:::note
    Note --- PersistentStores

