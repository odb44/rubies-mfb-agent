{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rubies-mfb.invalid/schemas/evaluation-report-v0.1.json",
  "title": "Rubies MFB Agent Evaluation Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run",
    "application",
    "configuration",
    "datasets",
    "summary",
    "suites",
    "critical_failures",
    "decision"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "started_at",
        "environment",
        "evaluator_version"
      ],
      "properties": {
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "finished_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "operator": {
          "type": [
            "string",
            "null"
          ]
        },
        "environment": {
          "type": "string",
          "minLength": 1
        },
        "evaluator_version": {
          "type": "string",
          "minLength": 1
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "application": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version"
      ],
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1
        },
        "git_commit": {
          "type": [
            "string",
            "null"
          ]
        },
        "build_id": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "prompt_version",
        "tool_schema_version",
        "retrieval_index_version"
      ],
      "properties": {
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "prompt_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "tool_schema_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "retrieval_index_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "embedding_model_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_manifest_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "fixture_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "configuration_notes": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "datasets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "suite",
          "path",
          "version",
          "sha256",
          "case_count"
        ],
        "properties": {
          "suite": {
            "enum": [
              "rag",
              "tool",
              "safety"
            ]
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{64}$"
          },
          "case_count": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "defined",
        "executed",
        "passed",
        "failed",
        "blocked",
        "needs_review",
        "not_run"
      ],
      "properties": {
        "defined": {
          "type": "integer",
          "minimum": 0
        },
        "executed": {
          "type": "integer",
          "minimum": 0
        },
        "passed": {
          "type": "integer",
          "minimum": 0
        },
        "failed": {
          "type": "integer",
          "minimum": 0
        },
        "blocked": {
          "type": "integer",
          "minimum": 0
        },
        "needs_review": {
          "type": "integer",
          "minimum": 0
        },
        "not_run": {
          "type": "integer",
          "minimum": 0
        },
        "critical_failure_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "suites": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/suiteResult"
      }
    },
    "critical_failures": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/criticalFailure"
      }
    },
    "thresholds": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/thresholdResult"
      }
    },
    "regression": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "compared_run_id",
        "new_failures",
        "resolved_failures",
        "notes"
      ],
      "properties": {
        "compared_run_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "new_failures": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "resolved_failures": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "rationale"
      ],
      "properties": {
        "status": {
          "enum": [
            "ACCEPT",
            "REJECT",
            "INCOMPLETE"
          ]
        },
        "rationale": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "approved_by": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  },
  "$defs": {
    "caseOutcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "outcome",
        "critical_failure",
        "assertions"
      ],
      "properties": {
        "case_id": {
          "type": "string",
          "minLength": 1
        },
        "outcome": {
          "enum": [
            "PASSED",
            "FAILED",
            "BLOCKED",
            "NEEDS_REVIEW",
            "NOT_RUN"
          ]
        },
        "critical_failure": {
          "type": "boolean"
        },
        "scores": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": {
            "type": "number",
            "minimum": 0
          },
          "description": "Suite-specific numeric scores; for RAG, dimensions use a 0–2 scale."
        },
        "assertions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "assertion_id",
              "passed"
            ],
            "properties": {
              "assertion_id": {
                "type": "string"
              },
              "passed": {
                "type": "boolean"
              },
              "expected": {},
              "actual": {},
              "evidence_ref": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "notes": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        "language": {
          "type": [
            "string",
            "null"
          ]
        },
        "expected_response_language": {
          "type": [
            "string",
            "null"
          ]
        },
        "language_match_pass": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "content_correctness_pass": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "citation_pass": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "safety_parity_pass": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "handoff_pass": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "tool_calls": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "tool_name",
              "outcome"
            ],
            "properties": {
              "tool_name": {
                "type": "string"
              },
              "outcome": {
                "type": "string"
              },
              "sanitized_input_ref": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "sanitized_output_ref": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "correlation_id": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        "citations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "critical_failure_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "block_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "reviewer_notes": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "suiteResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "suite",
        "defined",
        "executed",
        "passed",
        "failed",
        "blocked",
        "needs_review",
        "not_run",
        "cases"
      ],
      "properties": {
        "suite": {
          "enum": [
            "rag",
            "tool",
            "safety"
          ]
        },
        "defined": {
          "type": "integer",
          "minimum": 0
        },
        "executed": {
          "type": "integer",
          "minimum": 0
        },
        "passed": {
          "type": "integer",
          "minimum": 0
        },
        "failed": {
          "type": "integer",
          "minimum": 0
        },
        "blocked": {
          "type": "integer",
          "minimum": 0
        },
        "needs_review": {
          "type": "integer",
          "minimum": 0
        },
        "not_run": {
          "type": "integer",
          "minimum": 0
        },
        "metrics": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "number",
              "string",
              "boolean",
              "null"
            ]
          }
        },
        "cases": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/caseOutcome"
          }
        }
      }
    },
    "criticalFailure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "failure_id",
        "case_id",
        "category",
        "severity",
        "evidence_ref",
        "status"
      ],
      "properties": {
        "failure_id": {
          "type": "string"
        },
        "case_id": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "severity": {
          "enum": [
            "CRITICAL"
          ]
        },
        "evidence_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "enum": [
            "OPEN",
            "REMEDIATED",
            "ACCEPTED_RISK"
          ]
        },
        "owner": {
          "type": [
            "string",
            "null"
          ]
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "thresholdResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metric",
        "target",
        "actual",
        "denominator",
        "passed",
        "notes"
      ],
      "properties": {
        "metric": {
          "type": "string"
        },
        "target": {
          "type": [
            "number",
            "string"
          ]
        },
        "actual": {
          "type": [
            "number",
            "string",
            "null"
          ]
        },
        "denominator": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "passed": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  },
  "description": "Machine-readable schema for evaluator run reports. Validate report structure and apply documented cross-field invariants separately."
}
