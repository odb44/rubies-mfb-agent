# Local development only. Never put real credentials in this file.
APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://rubies:rubies@localhost:5432/rubies_mfb
SESSION_STORAGE_DIR=.local/sessions
VECTOR_INDEX_DIR=.local/vector_index

# JWT authentication — use a strong, private secret locally.
JWT_SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters
JWT_ISSUER=rubies-mfb
JWT_AUDIENCE=rubies-mfb-api
# Internal Banking API used by the agent direct HTTP client.
BANKING_API_BASE_URL=http://127.0.0.1:8000
AGENT_SERVICE_TOKEN=your_generated_secret